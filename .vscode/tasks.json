{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Debug",
            "type": "shell",
            "command": "make",
            "args": ["clean", "payload"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Build Release",
            "type": "shell",
            "command": "make",
            "args": ["clean", "package", "RELEASE=1"],
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Build TrollStore",
            "type": "shell",
            "command": "make",
            "args": ["clean", "package", "TROLLSTORE_JIT_ENT=1"],
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Deploy to Device",
            "type": "shell",
            "command": "make",
            "args": ["deploy"],
            "group": "test",
            "dependsOn": "Build Debug",
            "problemMatcher": []
        }
    ]
}
