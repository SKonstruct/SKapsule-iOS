{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Debug",
            "type": "shell",
            "command": "make",
            "args": ["xcode-build"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Build Release",
            "type": "shell",
            "command": "make",
            "args": ["clean", "package", "RELEASE=1"],
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Build TrollStore",
            "type": "shell",
            "command": "make",
            "args": ["clean", "package", "TROLLSTORE_JIT_ENT=1"],
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Deploy to Device",
            "type": "shell",
            "command": "make",
            "args": ["deploy"],
            "group": "test",
            "dependsOn": "Build Debug",
            "problemMatcher": []
        },
        {
            "label": "Build All",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "export JAVA_HOME=$(jenv prefix 25.0) && export CACIO_JAVA_HOME=$JAVA_HOME && export FRENCHPRESS_JAVA_HOME=$JAVA_HOME && ./scripts/build-gl4es-ios.sh && ./scripts/build-openal-ios.sh && ./scripts/build-lwjgl3-ios.sh && ./scripts/build-cacio-ios.sh && ./scripts/build-frenchpress-ios.sh && ./scripts/build-bootstrap.sh && ./scripts/stage-app-assets.sh && make package"
            ],
            "group": "build",
            "problemMatcher": []
        }
    ]
}
